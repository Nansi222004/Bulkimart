# Advertising management, local category pilot, billing, delivery, refunds and
# telemetry are always enabled. Gateway, campaign and policy checks still apply.
# Production additionally requires this explicit decision and live-mode keys.
# Test-mode keys and the non-billable pilot are rejected in production aliases.
ADVERTISING_PRODUCTION_ENABLED=false
# Checkout expiry is built in: sellers have 30 minutes to finish paying.
# Existing server-only PAYMENT_GATEWAY=razorpay, RAZORPAY_MODE=test for local,
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET are reused.
# Never put the server secret or webhook secret in a frontend environment.
# Retention policy: integer 1..365 days, defaults to 30; TTL deletion in Mongo.
ADVERTISING_EVENT_RETENTION_DAYS=30
# Optional: view/click tracking signs with a key derived from JWT_SECRET. Set a
# dedicated random secret (32+ characters, never in VITE_*) only to override it.
# ADVERTISING_TOKEN_SECRET=
