# Example only. No deployed or local environment is changed by this file.
# Management APIs and navigation remain off when unset.
ADVERTISING_MANAGEMENT_ENABLED=false
# Separate non-billable customer pilot gate. Production aliases always block it.
ADVERTISING_CATEGORY_PILOT_ENABLED=false
# Separate fixed-duration category billing and delivery gates. No CPC/CPM.
ADVERTISING_BILLING_ENABLED=false
ADVERTISING_PAID_DELIVERY_ENABLED=false
# Independent refund gate: retain authorized refund/reconciliation access if
# new management, billing or delivery is shut down. No automatic refunds.
ADVERTISING_REFUNDS_ENABLED=false
# Production additionally requires this explicit decision and live-mode keys.
# Test-mode keys and the non-billable pilot are rejected in production aliases.
ADVERTISING_PRODUCTION_ENABLED=false
# Required before checkout: explicit operational timeout, integer 60..86400.
ADVERTISING_CHECKOUT_TTL_SECONDS=
# Existing server-only PAYMENT_GATEWAY=razorpay, RAZORPAY_MODE=test for local,
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET are reused.
# Never put the server secret or webhook secret in a frontend environment.
ADVERTISING_TELEMETRY_ENABLED=false
# Required explicit retention policy: integer 1..365 days, TTL deletion in Mongo.
ADVERTISING_EVENT_RETENTION_DAYS=
# Dedicated random server secret, minimum 32 characters; never expose in VITE_*.
ADVERTISING_TOKEN_SECRET=
