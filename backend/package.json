{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "index.js",
  "scripts": {
    "test:image-search": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand --runTestsByPath verification/image-search.test.js",
    "image-search:index": "node scripts/imageSearchIndex.mjs",
    "test:rider-service-area": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand --runTestsByPath verification/rider-service-area.test.js",
    "test:parcel": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand --runTestsByPath verification/parcel-delivery.test.js verification/parcel-routing.test.js verification/parcel-shopping-capacity.test.js",
    "test:storefront": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand --runTestsByPath verification/storefront.test.js",
    "test:financial-workflow": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand --runTestsByPath verification/financial-workflow.test.js",
    "test:payment-notifications": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand --runTestsByPath verification/payment-notifications.test.js",
    "test:fcm-auth": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand",
    "audit:jwt": "node scripts/auditJwtDeployment.mjs",
    "build": "node api.js && node --check index.js && node scripts/checkServicePackage.mjs",
    "start": "node api.js && node index.js",
    "dev": "node api.js && nodemon index.js",
    "seed": "node seed/index.js",
    "seed:reset": "node seed/index.js --reset",
    "fix:indexes": "node seed/fixIndexes.js",
    "admin:password": "node seed/setAdminPassword.js",
    "check:cloudinary": "node seed/checkCloudinary.js",
    "fix:roles": "node seed/fixVendorRoles.js",
    "seed:categories": "node seed/seedCategories.js",
    "migrate:shopall": "node seed/migrateCategoriesToShopAll.js",
    "remove:mock-products": "node seed/removeMockProducts.js",
    "seed:real-products": "node seed/seedRealProducts.js",
    "stores:locate": "node seed/backfillStoreLocations.js",
    "stores:locate:apply": "node seed/backfillStoreLocations.js --apply",
    "test:loop": "node tests/quickCommerceLoop.mjs",
    "test:sameday": "node tests/sameDayEligibility.mjs",
    "delivery:unstick": "node scripts/releaseStuckDeliveries.mjs",
    "delivery:unstick:apply": "node scripts/releaseStuckDeliveries.mjs --apply",
    "accounts:cleanup:report": "node scripts/accountCleanup.mjs",
    "accounts:cleanup:apply": "node scripts/accountCleanup.mjs --apply --confirm=BULKIMART_ACCOUNT_CLEANUP",
    "accounts:verify-seller-registration": "node tests/verifySellerRegistration.mjs",
    "accounts:verify-cleanup": "node scripts/verifyAccountCleanup.mjs",
    "accounts:repair-references": "node scripts/repairCleanupReferences.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config __tests__/jest.config.js",
    "test:shiprocket-fees": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config verification/jest.config.js --runInBand --runTestsByPath verification/quick-shiprocket-fee.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "*",
    "bcryptjs": "*",
    "cloudinary": "*",
    "compression": "*",
    "cors": "*",
    "dotenv": "*",
    "exceljs": "^4.4.0",
    "express": "*",
    "express-rate-limit": "*",
    "express-validator": "*",
    "firebase-admin": "*",
    "helmet": "*",
    "jsonwebtoken": "*",
    "jszip": "^3.10.1",
    "mongodb": "*",
    "mongoose": "*",
    "morgan": "*",
    "multer": "*",
    "node-cron": "*",
    "razorpay": "*",
    "sharp": "^0.35.5",
    "socket.io": "*",
    "uuid": "*"
  },
  "devDependencies": {
    "jest": "*",
    "mongodb-memory-server": "*",
    "nodemon": "*",
    "supertest": "*"
  }
}
