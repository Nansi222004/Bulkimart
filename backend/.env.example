# Optional. Local default is backend/private-data/ebooks (private; never static-served).
EBOOK_STORAGE_DIR=
# Optional private PDF upload cap. Defaults to 25 MiB; allowed range is 1–250 MiB.
EBOOK_MAX_UPLOAD_BYTES=26214400

# Comma-separated exact browser origins allowed by Express and Socket.IO.
# Production defaults to https://bulkimart.in and https://www.bulkimart.in.
CORS_ORIGINS=

# Optional listener override. Leave empty on Hostinger so the app binds 0.0.0.0.
BIND_HOST=

# Integration modes are strict: OTP/Shiprocket/FCM/Maps accept live|mock;
# Razorpay accepts live|test. Select the gateway explicitly in production.
OTP_MODE=live
RAZORPAY_MODE=live
SHIPROCKET_MODE=live
FCM_MODE=live
MAPS_MODE=live
PAYMENT_GATEWAY=phonepe

# Required for document/image uploads. Configure either CLOUDINARY_URL or all
# three individual values. These are server-only; never place the secret in a
# VITE_* variable or browser code.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when PAYMENT_GATEWAY=razorpay. Keep secrets in the hosting
# environment, never in this file or Git. The key ID is public; the others are not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production-runtime mocks are allowed only on an isolated staging deployment.
# Never enable these on bulkimart.in or api.bulkimart.in.
DEPLOYMENT_ENV=production
ALLOW_MOCK_SERVICES=false
STAGING_DATA_ISOLATED=false
PUBLIC_API_URL=https://api.bulkimart.in

# Required when FCM_MODE=live. Store the service-account JSON as a Hostinger
# secret; FIREBASE_PROJECT_ID must match both it and the frontend Vite config.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
