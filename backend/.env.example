PORT=5000

# MongoDB
MONGO_URI=

# JWT — REQUIRED. The server refuses to start without this set (config/jwt.js).
# There is no fallback/default — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# OTP  (mock => OTP is always "1234" and is returned in the API response)
OTP_MODE=mock
OTP_LENGTH=4
OTP_TTL_MINUTES=5

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket
SHIPROCKET_MODE=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in

# Google Maps
MAPS_MODE=mock
GOOGLE_MAPS_API_KEY=

# Firebase FCM
FCM_MODE=mock

# CDS Membership
CDS_MODE=mock
CDS_DISCOUNT_PERCENT=5

# Admin Seed (used only on first boot when no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# development | production
NODE_ENV=development

# Alternative to the three vars above — paste straight from the Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
