# Required in production: absolute path on a private persistent volume outside
# versioned deployment/build directories. Local development may leave it blank.
EBOOK_STORAGE_DIR=
# Optional private PDF upload cap. Defaults to 25 MiB; allowed range is 1–250 MiB.
EBOOK_MAX_UPLOAD_BYTES=26214400

# Comma-separated exact browser origins allowed by Express and Socket.IO.
# Production defaults to https://bulkimart.in and https://www.bulkimart.in.
CORS_ORIGINS=

# Optional listener override. Leave empty on Hostinger so the app binds 0.0.0.0.
BIND_HOST=

# Integration modes are strict: OTP/FCM/Maps accept live|mock;
# Shiprocket accepts mock|sandbox|live. Local development should use mock.
# Razorpay accepts live|test. Select the gateway explicitly in production.
OTP_MODE=live
# Login OTP (services/sms.service.js). Defaults shown.
# OTP_LENGTH=6
# OTP_TTL_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_SENDS_PER_HOUR=10
# OTP_MAX_VERIFY_ATTEMPTS=5
# Android SMS Retriever autofill. The apps send their own runtime hash as
# `appHash`; these are fallbacks for clients that do not, and an optional
# allowlist (comma-separated) restricting which hashes may appear in the SMS.
# SMS_RETRIEVER_HASH_USER=
# SMS_RETRIEVER_HASH_SELLER=
# SMS_RETRIEVER_HASH_DELIVERY=
# SMS_RETRIEVER_ALLOWED_HASHES=
# OTP SMS (DLT, India). SMS_USE_LIVE=true sends real SMS and costs credit; anything else sends none
# (the OTP is still created, so test the flow first). The template text must match the DLT-registered
# one exactly and be quoted (it contains #). Its ##var## slots are filled with SMS_OTP_APP_NAME,
# SMS_OTP_POWERED_BY and the OTP, in that order. Keep OTP_TTL_MINUTES equal to the minutes it states.
SMS_USE_LIVE=false
# SMS_INDIA_HUB_URL=
# SMS_INDIA_HUB_API_KEY=
# SMS_INDIA_HUB_SENDER_ID=
# SMS_DLT_PE_ID=
# SMS_INDIA_HUB_DLT_TEMPLATE_ID=
# SMS_DLT_TEMPLATE_NAME=
# SMS_INDIA_HUB_TEMPLATE_TEXT="Welcome to ##var##, powered by ##var##. Your OTP for registration ##var##. ..."
# SMS_OTP_APP_NAME=Bulkimart
# SMS_OTP_POWERED_BY=
RAZORPAY_MODE=live
SHIPROCKET_MODE=live
# Live-only account credentials, backend secrets. Never use these for sandbox.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
# No publicly confirmed sandbox endpoint is assumed. Keep these empty until
# Shiprocket confirms a separate isolated endpoint AND test account in writing.
# The apidocs-test portal and standard API origin are NOT sandbox endpoints.
SHIPROCKET_SANDBOX_BASE_URL=
SHIPROCKET_SANDBOX_EMAIL=
SHIPROCKET_SANDBOX_PASSWORD=
SHIPROCKET_SANDBOX_WEBHOOK_SECRET=
SHIPROCKET_SANDBOX_CONFIRMED=false
FCM_MODE=live
MAPS_MODE=live
PAYMENT_GATEWAY=phonepe

# Required for document/image uploads. Configure either CLOUDINARY_URL or all
# three individual values. These are server-only; never place the secret in a
# VITE_* variable or browser code.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when PAYMENT_GATEWAY=razorpay. Keep secrets in the hosting
# environment, never in this file or Git. The key ID is public; the others are not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production-runtime mocks are allowed only on an isolated staging deployment.
# Never enable these on bulkimart.in or api.bulkimart.in.
DEPLOYMENT_ENV=production
ALLOW_MOCK_SERVICES=false
STAGING_DATA_ISOLATED=false
PUBLIC_API_URL=https://api.bulkimart.in

# Required when FCM_MODE=live. Store the service-account JSON as a Hostinger
# secret; FIREBASE_PROJECT_ID must match both it and the frontend Vite config.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=

# Features are always enabled, except the delivery-method switches below.
# Quick Commerce collection still requires approved fee/tax rules and provider setup in Admin.
# New orders always freeze their price/commission breakdown.
# Financial operations and payouts are active by default.
# Coupons and coins are always funded by Bulkimart.

# GST registration assistance is always available during seller onboarding.

# Delivery methods (Easy Ship / Self Delivery / Fulfilled by Bulkimart) and FBB warehouse + charges are
# always ON; nothing to set here. Emergency stop only: DELIVERY_METHODS_ENABLED / FBB_ENABLED /
# FBB_CHARGES_ENABLED / WAREHOUSE_OPERATIONS_ENABLED = false stops new activity (existing orders carry on).
# FBB is open only to sellers added in Admin → FBB → Pilot sellers unless this is true (general rollout).
FBB_ALL_SELLERS_ENABLED=false
# true = refuse FBB checkout when courier coverage cannot be confirmed (default refuses only a definite "no").
FBB_SERVICEABILITY_STRICT=false
# Keep off until Shiprocket confirms the COD fee line, COD amount and remittance (EXTERNAL_VERIFICATION.md A1–A3).
SHIPROCKET_COD_ENABLED=false
# Keep off until the accountant confirms GST treatment (EXTERNAL_VERIFICATION.md B2).
SELF_DELIVERY_FEE_CREDIT_ENABLED=false
