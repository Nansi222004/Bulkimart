# Optional. Local default is backend/private-data/ebooks (private; never static-served).
EBOOK_STORAGE_DIR=
# Optional private PDF upload cap. Defaults to 25 MiB; allowed range is 1–250 MiB.
EBOOK_MAX_UPLOAD_BYTES=26214400

# Comma-separated exact browser origins allowed by Express and Socket.IO.
# Production defaults to https://bulkimart.in and https://www.bulkimart.in.
CORS_ORIGINS=

# Optional listener override. Leave empty on Hostinger so the app binds 0.0.0.0.
BIND_HOST=
