# Hostinger staging frontend build variables. Firebase web values are public
# project identifiers, not Admin SDK credentials. Keep all server-side secrets
# in the backend application's Hostinger environment.
VITE_API_BASE_URL=https://api-staging.bulkimart.in
VITE_API_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

