{
  "name": "forntend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:rider-service-area": "node --test verification/rider-service-area-ui.test.mjs",
    "test:parcel-local": "node verification/parcel-manual-local.mjs",
    "test:parcel": "node --test --test-concurrency=1 verification/parcel-admin-ui.test.mjs verification/parcel-rider-dashboard.test.mjs verification/parcel-offers-ui.test.mjs verification/parcel-rider-ui.test.mjs verification/parcel-journey-ui.test.mjs verification/parcel-location-ui.test.mjs verification/parcel-read-ui.test.mjs verification/customer-services-ui.test.mjs tests/service-ui.test.mjs",
    "test:parcel-browser": "node verification/parcel-delivery-browser.mjs && node verification/parcel-journey-browser.mjs",
    "test:storefront": "node --test verification/storefront-ui.test.mjs verification/celebration-renderer.test.mjs",
    "test:storefront-browser": "npm run build && node verification/storefront-browser.mjs",
    "test:financial-workflow": "node --test verification/financial-workflow-ui.test.mjs",
    "test:financial-browser": "node verification/financial-workflow-browser.mjs",
    "test:payment-overlays": "node --test verification/razorpay-overlay.test.mjs verification/payment-ui.test.mjs",
    "test:fcm-auth": "node --test verification/fcm-auth.test.mjs",
    "test:startup": "node --test tests/portal-startup.test.mjs",
    "test:seller-notifications": "node --test tests/seller-notifications.test.mjs",
    "test:socket": "node --test tests/socket-ui.test.mjs",
    "test:mobile": "npm run build && node tests/mobile-layout.test.mjs && node tests/mobile-layout.test.mjs --dialogs && node tests/mobile-layout.test.mjs --seller && node tests/mobile-layout.test.mjs --startup",
    "test:checkout": "node --test tests/checkout-ui.test.mjs",
    "test:auth": "node --test tests/auth-role.test.mjs",
    "test:services": "node --test tests/service-ui.test.mjs",
    "test:image-search": "node --test verification/image-search-ui.test.mjs",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:responsive": "npm run build && node tests/mobile-layout.test.mjs --full && node tests/mobile-layout.test.mjs --native && node tests/mobile-layout.test.mjs --full --extended && node tests/mobile-layout.test.mjs --native --supplemental",
    "test:shiprocket-fees": "node --test verification/shiprocket-fee-ui.test.mjs",
    "test:finance-center": "node --test verification/finance-center-ui.test.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "*",
    "jszip": "^3.10.1",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "socket.io-client": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.2.0"
  }
}
