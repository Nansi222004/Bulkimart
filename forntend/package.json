{
  "name": "forntend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:payment-overlays": "node --test verification/razorpay-overlay.test.mjs verification/payment-ui.test.mjs",
    "test:fcm-auth": "node --test verification/fcm-auth.test.mjs",
    "test:startup": "node --test tests/portal-startup.test.mjs",
    "test:seller-notifications": "node --test tests/seller-notifications.test.mjs",
    "test:socket": "node --test tests/socket-ui.test.mjs",
    "test:mobile": "npm run build && node tests/mobile-layout.test.mjs && node tests/mobile-layout.test.mjs --dialogs && node tests/mobile-layout.test.mjs --seller && node tests/mobile-layout.test.mjs --startup",
    "test:checkout": "node --test tests/checkout-ui.test.mjs",
    "test:auth": "node --test tests/auth-role.test.mjs",
    "test:services": "node --test tests/service-ui.test.mjs",
    "test:image-search": "node --test tests/image-search-ui.test.mjs",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test:responsive": "npm run build && node tests/mobile-layout.test.mjs --full && node tests/mobile-layout.test.mjs --native && node tests/mobile-layout.test.mjs --full --extended && node tests/mobile-layout.test.mjs --native --supplemental",
    "test:shiprocket-fees": "node --test verification/shiprocket-fee-ui.test.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "*",
    "jszip": "^3.10.1",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "socket.io-client": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.2.0"
  }
}
